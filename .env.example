# Deployment wiring only. Everything else is configured in the dashboard's Settings page.
PORT=8787
# WC_DATA_DIR=~/.work-commander          # SQLite DB and agent session files (local)
# DATABASE_URL=postgresql://...          # use Postgres instead of SQLite
# WC_PUBLIC_URL=http://localhost:8787    # used for the Google OAuth redirect
# WC_HOSTING=local                       # local | gcp (auto-detected on Cloud Run)
# WC_AUTH_MODE=local                     # local | iap
# DEMO_MODE=1                            # in-memory demo systems + scripted agent
